# Copy this to .env. Everything here works for local development as it is, against a local
# database file: run `pnpm db:setup` once to create it.
# Only secrets and things that differ between environments belong here. Everything else, like
# dates, prices and which stages are open, is in src/config and on the Settings admin page.

# The database. Without TURSO_AUTH_TOKEN this has to be a local file.
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=

# Used by NextAuth. Any long random string, for example from `openssl rand -base64 32`.
AUTH_SECRET="local-development-only-change-me"
NEXTAUTH_URL="http://localhost:3000"

# Optional locally: the Google button won't work without these
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional locally: without it, emails are printed to the terminal instead of being sent
EMAIL_PASSWORD=

# Optional locally: uploading documents won't work without it. Vercel adds this when you create the Blob store.
BLOB_READ_WRITE_TOKEN=
